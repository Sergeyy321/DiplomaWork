# ============================================================
# DeepSeek API Configuration
# ============================================================
# Paste your DeepSeek API key below:
DEEPSEEK_API_KEY=

# DeepSeek Model (Options: deepseek-chat, deepseek-reasoner)
DEEPSEEK_MODEL=deepseek-chat

# Google Cloud OAuth Client ID (for Google Drive Cloud Sync)
REACT_APP_GOOGLE_CLIENT_ID=

# Server Port & API URL
PORT=3001
REACT_APP_API_URL=http://localhost:3001
